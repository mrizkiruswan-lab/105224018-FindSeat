
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SeatStatus {
  tersedia
  digunakan
  ditinggalkan
}

enum Role {
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  checkIns CheckIn[]
}

model Venue {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  category    String
  location    String
  description String
  createdAt   DateTime @default(now())

  seats Seat[]
}

model Seat {
  id        Int        @id @default(autoincrement())
  number    Int
  status    SeatStatus @default(tersedia)
  venueId   Int
  createdAt DateTime   @default(now())

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  checkIns CheckIn[]

  @@unique([venueId, number])
}

model CheckIn {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  seatId       Int
  userId       Int?
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  seat Seat  @relation(fields: [seatId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([seatId, checkedInAt])
  @@index([email])
  @@index([userId])
}
